                ]
              }
            }
          ],
          "request": {
            "description": "Scenario: school takes admissions for next year while the current year is still running. Passing an explicit sessionId (Session B, still Upcoming) overrides the default active-session tagging.",
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "firstName",
                  "value": "ZZPM",
                  "type": "text"
                },
                {
                  "key": "lastName",
                  "value": "NextYearStudent",
                  "type": "text"
                },
                {
                  "key": "gender",
                  "value": "Female",
                  "type": "text"
                },
                {
                  "key": "dateOfBirth",
                  "value": "2019-06-01",
                  "type": "text"
                },
                {
                  "key": "sessionId",
                  "value": "{{session_b_id}}",
                  "type": "text"
                },
                {
                  "key": "parent",
                  "value": "{\"primaryName\":\"ZZPM Parent 2\",\"primaryEmail\":\"zzpm.parent2.{{run_tag}}@example.com\",\"primaryPhone\":\"9876500001\",\"password\":\"{{parent_password}}\",\"relation\":\"Mother\"}",
                  "type": "text"
                },
                {
                  "key": "address",
                  "value": "{\"city\":\"Test City\",\"state\":\"Test State\",\"pincode\":\"400001\"}",
                  "type": "text"
                }
