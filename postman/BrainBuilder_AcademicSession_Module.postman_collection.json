    {
      "name": "5. Session Promotion & Correction [NEW]",
      "item": [
        {
          "name": "Promote Students (Session A -> Session B) [NEW]",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('1 success, 0 failed', () => { pm.expect(json.data.success).to.eql(1); pm.expect(json.data.failed).to.eql(0); });",
                  "const detail = json.data.results[0];",
                  "pm.test('per-student result includes newEnrollmentId', () => pm.expect(detail.newEnrollmentId).to.be.a('string'));",
                  "pm.collectionVariables.set('new_enrollment_id', detail.newEnrollmentId);"
                ]
              }
            }
          ],
          "request": {
            "description": "Promotes the student from Session A into Session B, into the same class (newClassId can be a different class for a real grade change). decision can be 'promote' | 'retain' | 'notContinuing'.",
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromSessionId\": \"{{session_a_id}}\",\n  \"toSessionId\": \"{{session_b_id}}\",\n  \"decisions\": [\n    {\n      \"studentId\": \"{{student_id}}\",\n      \"decision\": \"promote\",\n      \"newClassId\": \"{{class_id}}\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/fee/promotions"
          },
          "response": []
        },
        {
          "name": "Get Enrollments For Student (verify Promoted + new Active) [NEW behavior]",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "const old = json.data.find(e => e._id === pm.collectionVariables.get('enrollment_id'));",
                  "const fresh = json.data.find(e => e._id === pm.collectionVariables.get('new_enrollment_id'));",
                  "pm.test('old (Session A) enrollment is now Promoted', () => pm.expect(old.status).to.eql('Promoted'));",
                  "pm.test('new (Session B) enrollment is Active and links back via promotedFromEnrollmentId', () => { pm.expect(fresh.status).to.eql('Active'); pm.expect(fresh.promotedFromEnrollmentId).to.eql(pm.collectionVariables.get('enrollment_id')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{base_url}}/fee/enrollments/{{student_id}}"
          },
          "response": []
        },
        {
          "name": "Mark Enrollment Left (correction / rollback) [NEW]",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('enrollment now Left', () => pm.expect(json.data.status).to.eql('Left'));"
                ]
              }
            }
          ],
          "request": {
            "description": "Use when a promoted student is later found to have actually left the school (e.g. transferred elsewhere) without notice. Only ever touches the NEW-session enrollment passed here — never the old session's history.",
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"ZZPM test — family transferred out\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/fee/enrollments/{{new_enrollment_id}}/mark-left"
          },
          "response": []
        },
        {
          "name": "Get Enrollments For Student (verify OLD session untouched) [NEW behavior]",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "const old = json.data.find(e => e._id === pm.collectionVariables.get('enrollment_id'));",
                  "pm.test('old (Session A) enrollment is still Promoted, unaffected by the correction', () => pm.expect(old.status).to.eql('Promoted'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{base_url}}/fee/enrollments/{{student_id}}"
          },
          "response": []
        }
      ]
    },
    {
      "name": "99. Cleanup",
      "item": [
        {
          "name": "Cancel Enrollment (Session B, promoted-then-left)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{base_url}}/fee/enrollments/{{new_enrollment_id}}"
          },
          "response": []
        },
        {
          "name": "Cancel Enrollment (Session A, original)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{base_url}}/fee/enrollments/{{enrollment_id}}"
          },
          "response": []
        }
      ]
    }
  ]
}
