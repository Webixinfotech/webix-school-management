{
  "name": "brainbuilder-backend",
  "version": "2.0.0",
  "description": "BrainBuilder School Management System Backend API - Production Grade Architecture",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "jest --detectOpenHandles --coverage",
    "test:watch": "jest --detectOpenHandles --watch",
    "test:prod": "NODE_ENV=production jest --detectOpenHandles",
    "db:seed": "node src/scripts/seed.js",
    "db:seed:inventory": "node src/scripts/seedInventory.js",
    "db:migrate": "node src/scripts/migrate.js",
    "db:backfill:academicSession": "node src/scripts/backfillAcademicSession.js"
  },
  "keywords": [
    "brainbuilder",
    "school-management",
    "api",
    "backend",
    "rest-api",
    "nodejs",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/brainbuilder-backend.git"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1028.0",
    "@aws-sdk/lib-storage": "^3.1028.0",
    "@aws-sdk/s3-request-presigner": "^3.1028.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "firebase-admin": "^13.8.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "multer-s3": "^3.0.1",
    "node-cron": "^4.2.1",
    "pdfkit": "^0.18.0",
    "qrcode": "^1.5.4",
    "uuid": "^13.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  }
}
