                "{{base_url}}"
              ],
              "path": [
                "classes"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "Active"
                },
                {
                  "key": "limit",
                  "value": "1"
                }
              ]
            }
          },
          "response": []
