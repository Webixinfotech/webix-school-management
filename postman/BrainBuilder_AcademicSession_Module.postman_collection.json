        {
          "name": "Admit Student (defaults to the Active session) [MODIFIED]",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('student_id', json.data.student.id);",
                  "pm.test('student auto-tagged with Session A (the Active one)', () => pm.expect(json.data.student.sessionId).to.eql(pm.collectionVariables.get('session_a_id')));"
                ]
              }
            }
          ],
          "request": {
            "description": "sessionId is NOT sent here on purpose — it auto-fills from whichever AcademicSession is currently Active (Session A). NOTE: this request creates a new parent User account; on environments hit by the pre-existing users-collection write-hang issue, this call may not return — see the collection description.",
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "firstName",
                  "value": "ZZPM",
                  "type": "text"
                },
                {
                  "key": "lastName",
                  "value": "CurrentYearStudent",
                  "type": "text"
                },
                {
                  "key": "gender",
                  "value": "Male",
                  "type": "text"
                },
                {
                  "key": "dateOfBirth",
                  "value": "2019-01-01",
                  "type": "text"
                },
                {
                  "key": "parent",
                  "value": "{\"primaryName\":\"ZZPM Parent\",\"primaryEmail\":\"zzpm.parent.{{run_tag}}@example.com\",\"primaryPhone\":\"9876500000\",\"password\":\"{{parent_password}}\",\"relation\":\"Father\"}",
                  "type": "text"
                },
                {
                  "key": "address",
                  "value": "{\"city\":\"Test City\",\"state\":\"Test State\",\"pincode\":\"400001\"}",
                  "type": "text"
                }
              ]
            },
            "url": "{{base_url}}/students"
          },
          "response": []
        },
