# # ==========================================
# # BrainBuilder Backend Environment Variables
# # ==========================================
# # Copy this file to .env and update with your actual values
# # NEVER commit .env to version control

# # ==========================================
# # Server Configuration
# # ==========================================
# PORT=5000
# NODE_ENV=development

# # ==========================================
# # MongoDB Configuration
# # ==========================================
# # MongoDB connection string (Atlas or local)
# # Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?<options>
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/brainbuilder?retryWrites=true&w=majority

# # ==========================================
# # JWT Configuration
# # ==========================================
# # Secret key for signing JWT tokens (use a strong random string)
# # Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# JWT_SECRET=your_jwt_secret_key_here_change_this_in_production

# # Token expiration time (e.g., 7d, 24h, 60m)
# JWT_EXPIRE=7d

# # Cookie expiration time in days
# JWT_COOKIE_EXPIRE=7

# # ==========================================
# # Admin Configuration
# # ==========================================
# # Secret key for admin registration (change this!)
# ADMIN_SECRET_KEY=brainbuilder_admin_2024_secure_key

# # ==========================================
# # Frontend Configuration
# # ==========================================
# # Comma-separated list of allowed frontend origins for CORS
# # Example: https://brain-builder-five.vercel.app,http://localhost:5173
# FRONTEND_URL=https://brain-builder-five.vercel.app,http://localhost:5173

# # ==========================================
# # AWS S3 Configuration
# # ==========================================
# # AWS Access Key ID (get from AWS IAM Console)
# AWS_ACCESS_KEY_ID=your_aws_access_key_id_here

# # AWS Secret Access Key (get from AWS IAM Console)
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# # S3 Bucket Name (create in AWS S3 Console)
# AWS_S3_BUCKET_NAME=your_bucket_name_here

# # AWS Region (e.g., ap-south-1 for Mumbai, us-east-1 for N. Virginia)
# AWS_S3_REGION=ap-south-1

# # S3 Folder Structure (optional, default: uploads)
# AWS_S3_FOLDER=uploads

# # ==========================================
# # Firebase Configuration (Optional - for push notifications)
# # ==========================================
# # Firebase Service Account JSON key (paste the entire JSON content from Firebase Console)
# # Go to: Firebase Console → Project Settings → Service Accounts → Generate new private key
# # Then paste the entire JSON content here (keep it as a single line or use proper escaping)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your_project_id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@your_project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"...","universe_domain":"googleapis.com"}

# # ==========================================
# # Redis Configuration (Optional - for caching & sessions)
# # ==========================================
# # REDIS_URL=redis://localhost:6379
# # REDIS_PASSWORD=your_redis_password
# # REDIS_PORT=6379

# # ==========================================
# # Email Configuration (Optional - for OTP & notifications)
# # ==========================================
# # SMTP_HOST=smtp.gmail.com
# # SMTP_PORT=587
# # SMTP_USER=your_email@gmail.com
# # SMTP_PASS=your_app_password
# # EMAIL_FROM=noreply@brainbuilder.com

# # ==========================================
# # Logging Configuration
# # ==========================================
# # Log level: error, warn, info, http, debug
# LOG_LEVEL=debug
