{
  "info": {
    "name": "Brain Builder - Referral System API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Complete Postman collection for Referral & Referral Tracking APIs. Base URL configured via 'baseUrl' environment variable.",
    "_exporter_id": "brainbuilder-referral-system"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string",
      "description": "Backend base URL — set to http://localhost:5000 for local, or https://your-api.onrender.com for production."
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string",
      "description": "JWT access token. Paste after logging in via Auth API."
    },
    {
      "key": "parentId",
      "value": "",
      "type": "string",
      "description": "Auto-filled by tests — _id of the logged-in parent."
    },
    {
      "key": "referralCode",
      "value": "BBA1A2B3",
      "type": "string",
      "description": "Referral code used for link referral submission."
    },
    {
      "key": "referralId",
      "value": "",
      "type": "string",
      "description": "Auto-filled by tests — _id of the referral just created."
    },
    {
      "key": "testAdminToken",
      "value": "",
      "type": "string",
      "description": "JWT token of an admin/sub-admin user."
    },
    {
      "key": "testParentToken",
      "value": "",
      "type": "string",
      "description": "JWT token of a parent user."
    }
  ],
  "item": [
    {
      "name": "📋 Setup — Pre-requisites",
      "description": "Run these first to get valid tokens and a referral code before testing referral flows.",
      "item": [
        {
          "name": "1. Login as Parent → Get Parent Token",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"parent@brainbuilder.com\",\n  \"password\": \"YourPassword123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "protocol": "http",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "if (data.success && data.data.token) {",
                  "    pm.environment.set('testParentToken', data.data.token);",
                  "    pm.environment.set('accessToken', data.data.token);",
                  "    pm.test('Token received', function () { pm.expect(data.data.token).to.be.a('string'); });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "✅ Test Mode — Using Pre-filled Tokens",
      "description": "If Postman collection tests fail due to CORS issues on a browser-based setup, use these endpoints directly to verify the referral system.",
      "item": [
        {
          "name": "Test Database Connection",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "protocol": "http",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "🚀 REFERRAL MODULE — Reviews",
      "description": "All referral endpoints including check-mobile, manual referral, link referral, parent-self referral listing, and stats.",
      "item": [
        {
          "name": "1. Check if Mobile is Already Referred",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "pm.test('Status is 200', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "pm.test('Response has success flag', function () { pm.expect(data.success).to.be.true); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{testParentToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"9876543210\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/referrals/check-mobile",
              "protocol": "http",
              "host": ["{{baseUrl}}"],
              "path": ["api", "referrals", "check-mobile"]
            }
          },
          "response": []
        },
        {
          "name": "2. Create Manual Referral (Parent)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "pm.test('Status is 201', function () { pm.expect(pm.response.code).to.eql(201); });",
                  "pm.test('Referral created', function () { pm.expect(data.success).to.be.true); });",
                  "if (data.data && data.data.referralId) {",
                  "    pm.environment.set('referralId', data.data.referralId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{testParentToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"friendName\": \"Rahul Sharma\",\n  \"friendMobile\": \"9876543210\",\n  \"childName\": \"Aarav Sharma\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/referrals/manual",
              "protocol": "http",
              "host": ["{{baseUrl}}"],
              "path": ["api", "referrals", "manual"]
            }
          },
          "response": []
        },
